APP_ENV=development
APP_NAME=VidInsight
APP_SECRET_KEY=change-this-to-a-long-random-secret
TOKEN_ENCRYPTION_KEY=change-this-to-a-different-long-random-secret
DATABASE_URL=postgresql+asyncpg://vidinsight:vidinsight@postgres:5432/vidinsight
REDIS_URL=redis://redis:6379/0
FRONTEND_ORIGINS=http://localhost:5173,http://localhost
ADMIN_EMAIL=admin@vidinsight.local
ADMIN_PASSWORD=ChangeMe123!
DATA_SOURCE_URL=
DATA_SOURCE_TOKEN=
# Optional full-metric contract endpoints. These are machine-to-machine bridges
# operated by your approved provider / Computer Use worker / crawler worker.
COMPUTER_USE_SOURCE_URL=
COMPUTER_USE_SOURCE_TOKEN=
# For the compatible Chrome creator-data collector. Generate a distinct secret;
# set DEFAULT_ACCOUNT_ID only when one dedicated collector endpoint is used.
COMPUTER_USE_INGEST_TOKEN=
COMPUTER_USE_DEFAULT_ACCOUNT_ID=
CONTROLLED_CRAWLER_SOURCE_URL=
CONTROLLED_CRAWLER_SOURCE_TOKEN=
DATA_SOURCE_TIMEOUT_SECONDS=20
FRONTEND_APP_URL=http://localhost
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=https://your-domain.example/api/v1/integrations/douyin/callback
DOUYIN_SCOPES=user_info,video.list
DOUYIN_BUSINESS_ACCESS_TOKEN=
ENABLE_COMPUTER_USE=false
ENABLE_CONTROLLED_CRAWLER=false
CRAWLER_ALLOWED_DOMAINS=
EXPORT_DIR=/app/exports
