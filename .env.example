APP_ENV=development
APP_NAME=VidInsight
APP_SECRET_KEY=change-this-to-a-long-random-secret
TOKEN_ENCRYPTION_KEY=change-this-to-a-different-long-random-secret
DATABASE_URL=postgresql+asyncpg://vidinsight:vidinsight@postgres:5432/vidinsight
REDIS_URL=redis://redis:6379/0
FRONTEND_ORIGINS=http://localhost:5173,http://localhost
ADMIN_EMAIL=admin@vidinsight.local
ADMIN_PASSWORD=ChangeMe123!
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=http://localhost/api/v1/oauth/douyin/callback
ENABLE_COMPUTER_USE=false
ENABLE_CONTROLLED_CRAWLER=false
CRAWLER_ALLOWED_DOMAINS=
EXPORT_DIR=/app/exports

